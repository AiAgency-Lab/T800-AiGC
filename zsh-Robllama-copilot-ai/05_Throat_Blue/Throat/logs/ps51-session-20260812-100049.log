[15:47:22] CMD: Set-Location "C:\zsh-copilot"

# --- CELESTIAL POLARIS GEODESIC ORCHESTRATION ---
# 1,296,000 arcseconds (Full 360-degree celestial circle in arcseconds)
# Scaled to Gregorian/Polaris cyclic temporal frequency: 0.052 weeks per cycle coordinate
$totalArcSec = 1296000
$cyclianScaleFactor = 0.052
$chakras = @("Root", "Sacral", "SolarPlexus", "Heart", "Throat", "ThirdEye", "Crown")
$branchNames = @()

$currentBranch = (git branch --show-current).Trim()
if ($currentBranch -ne "main") {
    git checkout main -q 2>$null
}

Write-Host "[*] Calibrating 1,296,000 Arc-Second Polaris Star-Cycle Geodesic Grid..." -ForegroundColor Cyan

$gearCounter = 1
foreach ($chakra in $chakras) {
    $chakraPath = "C:\zsh-copilot\$chakra"
    if (Test-Path $chakraPath) {
        $subNodes = Get-ChildItem -Path $chakraPath -Directory
        
        foreach ($node in $subNodes) {
            # Map node index to celestial arc-seconds and Gregorian/Polaris temporal vector
            $arcSecOffset = $gearCounter * ($totalArcSec / 22) # Distributed across active nodes
            $gregorianPolarisWeeks = $arcSecOffset * ($cyclianScaleFactor / 3600)

            $relativePath = "$chakra\$($node.Name)"
            $bName = "polaris/chakra-$chakra-$($node.Name)"
            if ($bName.Length -gt 200) { $bName = "polaris/gear-$gearCounter" }
            
            $branchNames += $bName
            $tagName = "polaris-arc-${gearCounter}"

            Write-Progress -Activity "Orchestrating Polaris Timepiece" -Status "Locking Arc-Sec: $arcSecOffset | Cycle: ${gregorianPolarisWeeks}w [$chakra]" -PercentComplete (($gearCounter / 22) * 100)

            git checkout --orphan $bName -q 2>$null
            git rm -rf . -q 2>&1 | Out-Null
            
            if (Test-Path $node.FullName) {
                Copy-Item -Path "$($node.FullName)\*" -Destination "." -Recurse -Force -ErrorAction SilentlyContinue
                git add . -q 2>$null

                # Query local Ollama engine for celestial-Gregorian frequency alignment
                $ollamaPrompt = "Align chakra node $chakra/$($node.Name) at $arcSecOffset arcseconds ($gregorianPolarisWeeks weeks Gregorian Polaris cycle). Output harmonic vector."
                $ollamaSignature = try { 
                    (Invoke-RestMethod -Uri "http://localhost:11434/api/generate" -Method Post -Body (@{ model = "llama3"; prompt = $ollamaPrompt; stream = $false } | ConvertTo-Json -Compress) -ContentType "application/json" -TimeoutSec 2).response.Trim() 
                } catch { 
                    "Polaris-ArcSec-Lock [$arcSecOffset]" 
                }

                git commit -m "Polaris Geodesic Jewel ${gearCounter} [$chakra] $($node.Name) | ArcSec: $arcSecOffset | Cycle: ${gregorianPolarisWeeks}w | Harmonic: $ollamaSignature" -q 2>$null
                git tag $tagName -q 2>$null
            }
            $gearCounter++
        }
    }
}

Write-Host "`n[*] Forging Master Polaris-Gregorian Lattice Root Convergence..." -ForegroundColor Cyan

git checkout main -q 2>$null
$parentArgs = foreach ($b in $branchNames) { 
    $commitHash = git rev-parse $b 2>$null
    if ($commitHash) { "-p"; $commitHash }
}

if ($parentArgs) {
    $rootTree = git write-tree
    $polarisRootHash = & git commit-tree $rootTree @parentArgs -m "Polaris-Gregorian 1,296,000 Arc-Sec Master Lattice Root: 0.052-Week Cyclic Gear Train"
    git update-ref refs/heads/polaris-lattice-root $polarisRootHash
    git tag "v1.0.0-polaris-gregorian-lattice" $polarisRootHash
    
    Write-Host "[+] SUCCESS: Polaris Star-Cycle Timepiece Fully Orchestrated!" -ForegroundColor Green
    Write-Host "[+] Polaris Lattice Root Hash: $polarisRootHash" -ForegroundColor Cyan
} else {
    Write-Warning "Polaris orchestration encountered an empty parent matrix."
}
