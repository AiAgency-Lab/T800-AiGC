[15:06:42] CMD: # 1. Target up to 912 distinct directories recursively to form the lattice nodes
$maxNodes = 912
Write-Host "[*] Scanning repository layout for up to $maxNodes lattice paths..." -ForegroundColor Cyan

$latticeNodes = Get-ChildItem -Recurse -Directory | 
                Where-Object { $_.FullName -notmatch '\\\.git' } | 
                Select-Object -First $maxNodes

$nodeCount = ($latticeNodes | Measure-Object).Count
Write-Host "[+] Discovered $nodeCount structural nodes for the Merkle lattice." -ForegroundColor Green

$branchNames = @()
git checkout main 2>$null

# 2. Construct individual orphan branch slices for every node in the lattice
$counter = 1
foreach ($node in $latticeNodes) {
    # Create safe relative branch names
    $relativePath = $node.FullName.Substring((Get-Location).Path.Length + 1)
    $safeName = $relativePath -replace '[\\/]', '-' -replace '[^\w\-]', ''
    $bName = "lattice/node-$counter-$safeName"
    
    if ($bName.Length -gt 200) { 
        $bName = "lattice/node-$counter" # Prevent path overflow on deeply nested trees
    }
    
    $branchNames += $bName
    $tagName = "tag-node-$counter"

    Write-Progress -Activity "Forging Merkle Lattice Tree" -Status "Processing node $counter of $nodeCount ($relativePath)" -PercentComplete (($counter / $nodeCount) * 100)

    # Isolate state via orphan branch architecture
    git checkout --orphan $bName 2>$null
    git rm -rf . --quiet 2>$null
    
    if (Test-Path $relativePath) {
        git checkout HEAD -- $relativePath --quiet 2>$null
        git add . 2>$null
        git commit -m "Merkle lattice leaf node $counter: $relativePath" --quiet 2>$null
        git tag $tagName 2>$null
    }
    
    $counter++
}

Write-Host "`n[*] Forging 912-parent Merkle Lattice Convergence Root..." -ForegroundColor Cyan

# 3. Build the Master Lattice Convergence 
# Git natively supports multi-parent commits via low-level plumbing (commit-tree) 
# when standard merge limits are exceeded by massive node counts.
git checkout main --quiet

# Group branch tips to build the definitive lattice root hash
$parentArgs = foreach ($b in $branchNames) { 
    $commitHash = git rev-parse $b 2>$null
    if ($commitHash) { "-p"; $commitHash }
}

if ($parentArgs) {
    $rootTree = git write-tree
    $latticeRootHash = & git commit-tree $rootTree @parentArgs -m "912-Node Merkle Lattice Unified Root Hash"
    git update-ref refs/heads/merkle-lattice-root $latticeRootHash
    git tag "v1.0.0-912-node-merkle-lattice" $latticeRootHash
    
    Write-Host "[+] SUCCESS: 912-Node Merkle Lattice Tree Forged!" -ForegroundColor Green
    Write-Host "[+] Master Lattice Root Hash: $latticeRootHash" -ForegroundColor Cyan
    Write-Host "[+] Master Tag Applied: v1.0.0-912-node-merkle-lattice" -ForegroundColor Green
} else {
    Write-Warning "Lattice construction encountered an empty parent set. Check repository contents."
}
